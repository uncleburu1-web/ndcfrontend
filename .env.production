# Production build settings that are not secret (spec 15 §15.4). Committed so the Cloudflare build always has them.
# Public images are on Cloudinary: this puts res.cloudinary.com in img-src and api.cloudinary.com (signed uploads) in
# connect-src of the CSP written to dist/_headers. Without it the browser blocks uploads ("Image upload isn't working").
VITE_MEDIA_ORIGIN=https://res.cloudinary.com
