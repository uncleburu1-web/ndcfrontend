# Copy to .env.local (spec 02 §10). Use the Clerk DEVELOPMENT instance key locally.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Spec 14: published in /.well-known/security.txt and on /security
VITE_SECURITY_CONTACT=security@example.ng
# Spec 15: images. Local development serves them from the API; with Cloudinary set https://res.cloudinary.com
# (CSP img-src; uploads then go to https://api.cloudinary.com). Never put a secret in a VITE_ variable.
VITE_MEDIA_ORIGIN=
